APP_ENV=dev

# Supabase: Connect > Direct tab > Session pooler. Replace the three placeholders.
# Keep the "postgresql+psycopg://" prefix. Use a password with letters and digits only.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres

# Files are stored in a local folder until task 0.3 (Supabase Storage)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads

LLM_API_KEY=changeme

# Tool-call limiting (see docs/system_architecture.md)
TOOL_CALL_LIMIT_PER_TICKET=8
TOOL_CALL_LIMIT_PER_TOOL=3
TOOL_TIMEOUT_SECONDS=15
TICKET_TIMEOUT_SECONDS=60
TOOL_RETRY_MAX=2

# Citizen uploads
UPLOAD_MAX_FILES=5
UPLOAD_MAX_MB=5
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png
