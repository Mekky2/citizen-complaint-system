APP_ENV=dev

# Supabase: Connect > Direct tab > Session pooler. Replace the three placeholders.
# Keep the "postgresql+psycopg://" prefix. Use a password with letters and digits only.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres

# Files are stored in a local folder until task 0.3 (Supabase Storage)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads

LLM_API_KEY=changeme
LLM_TIMEOUT_SECONDS=120

# Tool-call limiting (see docs/system_architecture.md)
TOOL_CALL_LIMIT_PER_TICKET=8
TOOL_CALL_LIMIT_PER_TOOL=3
TOOL_TIMEOUT_SECONDS=15
TICKET_TIMEOUT_SECONDS=60
TOOL_RETRY_MAX=2

# Citizen uploads
UPLOAD_MAX_FILES=5
UPLOAD_MAX_MB=5
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png

# Browser origins allowed to call the API (comma-separated).
# Default when unset: http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=

# LLM provider (names only; keep the key in a local .env, never in git)
# Defaults: provider=nvidia_nim, model=mistralai/mistral-large-4-1t-a52b
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_BASE_URL=

# RAG embeddings: "hashing" is offline/deterministic, "openai_compatible" needs a key.
# Defaults: provider=hashing, dimension=1024. Dimension must match the pgvector migration.
# EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_DIMENSION=
# EMBEDDING_TIMEOUT_SECONDS=

# RAG retrieval (defaults: top_k=5, threshold=0.55)
# RAG_TOP_K=
# RAG_SIMILARITY_THRESHOLD=

# Complaint conversation (defaults: max_turns=6, min_confidence=0.55)
# COMPLAINT_MAX_TURNS=
# COMPLAINT_MIN_CONFIDENCE=
# KNOWLEDGE_DIR=

# Duplicate complaint detection (default: 0.45; best of Jaccard and overlap)
# DUPLICATE_SIMILARITY_THRESHOLD=
