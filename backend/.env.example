# EG Civic Operations — Backend environment configuration
# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database -----------------------------------------------------------
# Must point at the ALREADY-EXISTING egcivic database created by
# database/init/01_extensions.sql .. 06_seed.sql. The backend never creates
# or alters schema objects at runtime — see README "Database baseline".
DATABASE_URL=postgresql+psycopg://egcivic_user:egcivic_password@localhost:5432/egcivic

# --- JWT ------------------------------------------------------------------
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- AI service integration -----------------------------------------------
# Base URL of the AI team's service. The backend calls POST {AI_SERVICE_URL}/v1/runs
# to trigger a run; the AI service calls back to this backend's own
# POST /api/v1/ai/recommendations when the run completes (see app/ai/client.py).
AI_SERVICE_URL=http://localhost:9000
AI_SERVICE_TIMEOUT_SECONDS=30
# Shared secret the backend sends to the AI service, and the AI service must
# send back on its callback, so one-way trust isn't assumed in either direction.
AI_SERVICE_SHARED_SECRET=change-me-too

# --- App --------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
